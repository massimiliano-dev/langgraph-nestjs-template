# Copy to .env and fill in. Never commit .env. All values below are placeholders.
# Values wrapped in __double_underscores__ are refused at boot until you replace them.

# --- Server -------------------------------------------------------------------
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# --- Database (shared pool for the LangGraph checkpointer and app tables) -----
# Host port used by compose for PostgreSQL (change it if 5432 is taken, and update DATABASE_URL).
POSTGRES_PORT=5432
DATABASE_URL=postgresql://agent:local-dev-only-password@127.0.0.1:5432/agent
DB_SCHEMA=agent
DB_POOL_MAX=10
DB_AUTO_MIGRATE=true

# --- Authentication -------------------------------------------------------------
# api-key: service-to-service keys (the web app's server uses one). Comma-separated, >= 32 chars each.
# Generate: openssl rand -hex 32
AUTH_MODE=api-key
API_KEYS=__generate_with_openssl_rand_hex_32__
# jwt: verify user tokens from your identity provider. Set exactly one of JWT_JWKS_URL / JWT_SECRET.
# AUTH_MODE=jwt
# JWT_ISSUER=https://login.example.com/
# JWT_AUDIENCE=agent-api
# JWT_JWKS_URL=https://login.example.com/.well-known/jwks.json
# JWT_SECRET=__only_for_hs256_at_least_32_chars__
# JWT_ALGORITHMS=RS256
# JWT_TENANT_CLAIM=tenant_id

# --- HTTP hardening -----------------------------------------------------------------
# Browser origins allowed to call the API directly (comma-separated, no "*"). Empty = no CORS.
# The bundled web app calls the API server-side, so it needs no CORS.
CORS_ORIGINS=
BODY_LIMIT=16kb
MAX_MESSAGE_CHARS=4000

# --- LLM ------------------------------------------------------------------------------
# openai | azure-openai
LLM_PROVIDER=openai
OPENAI_API_KEY=__your_openai_api_key__
OPENAI_MODEL=gpt-4.1-mini
# AZURE_OPENAI_API_KEY=__your_azure_openai_key__
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=your-deployment
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_MODEL=gpt-4.1-mini
LLM_TEMPERATURE=0
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=2
# USD per 1M tokens, merged over the defaults in apps/api/src/config/pricing.ts
# LLM_PRICING_JSON={"gpt-4.1-mini":{"input":0.4,"output":1.6}}

# --- Agent and tenant limits ----------------------------------------------------------
AGENT_MAX_STEPS=12
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_BURST=10
TENANT_MONTHLY_TOKEN_BUDGET=1000000
SEND_EMAIL_ALLOWED_DOMAINS=example.com

# --- Observability ------------------------------------------------------------------
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_SERVICE_NAME=langgraph-agent-api
# Keep false unless you have decided to store prompts, completions and tool arguments (PII) in traces.
OTEL_CAPTURE_CONTENT=false
# LangSmith tracing sends prompts and tool data to a third party. Leave off unless you mean it.
LANGSMITH_TRACING=false

# --- Web app (server-side only, never exposed to the browser) ----------------------
AGENT_API_URL=http://127.0.0.1:3000
# Must be one of API_KEYS.
AGENT_API_KEY=__generate_with_openssl_rand_hex_32__
# PLACEHOLDER: a real app derives the tenant from the signed-in user's session.
AGENT_DEMO_TENANT_ID=demo

# --- Evals ------------------------------------------------------------------------------
EVAL_MIN_SCORE=0.8
