{
  "name": "langgraph-nestjs-template",
  "private": true,
  "type": "module",
  "description": "Production-oriented NestJS + LangGraph.js agent backend with human approval, tenant isolation, observability and evals.",
  "license": "MIT",
  "author": "Massimiliano Polce",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/massimiliano-dev/langgraph-nestjs-template.git"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "eval": "vitest run --project evals"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "overrides": {
      "multer@<2.5.0": "^2.5.0"
    }
  }
}
